{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "courselens-session",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-23",
  // 保留在 Cloudflare Dashboard 中配置的环境变量与加密 Secrets，避免后续更新覆盖。
  "keep_vars": true,
  "vars": {
    "PORTAL_SYSTEM": "auto",
    "KEEPALIVE_INTERVAL_SEC": "0",
    "SESSION_VERIFY_TTL_SEC": "120",
    "PROXY_CACHE_ENABLED": "true",
    "CACHE_TTL_CATALOG_SEC": "1800",
    "CACHE_TTL_SCHEDULE_SEC": "1800",
    "CACHE_TTL_GRADES_SEC": "300",
    "CACHE_TTL_EXAMS_SEC": "600",
    "CACHE_TTL_PROGRESS_SEC": "3600",
    "CACHE_TTL_ENROLLED_SEC": "600",
    "CACHE_TTL_CLASSROOMS_SEC": "120",
    "CACHE_TTL_STATIC_SEC": "86400",
    "CORS_ORIGIN": "*"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_VAULT",
        "class_name": "PortalSessionVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PortalSessionVault"]
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
